# Build products (regenerated by make). `/build/*` is a blanket exclude
# and the one SOURCE file under build/ has to earn its way back in below.
#
# build/watcom/{cli,clidos,dll,gui} are OBJECT DIRECTORIES (verified with
# `file`: they are directories of .obj, not scripts - the Watcom recipes
# live in the Makefile). gen_exports.py is the one real source file in
# there, a DLL build-time dependency.
#
# build/*.sh and the rest of build/ are the development tree's gates and
# probes - the parity checks, the cross-build engines (ARM/MIPS/x87), the
# instruction censuses. They are internal and do not ship in a release;
# a public clone gets only the engine, the Makefile and gen_exports.py.
# Re-include the DIRECTORY before its contents: git does not descend
# into an excluded directory.

/build/*
!/build/watcom/
/build/watcom/*
!/build/watcom/gen_exports.py

# Design notes and internal documentation: not shipped. The public tree
# carries README.md and LICENSE only.
/docs/

# Claude Code / AI assistant local config (machine-specific, not source).
# CLAUDE.md is the working rules for the private tree; the release tree
# carries none of it.
.claude/
.claude.json
.claude.json.backup
.mcp.json
CLAUDE.local.md
CLAUDE.md
.aider*
.cursor/
.codeium/
.github/copilot-instructions.local.md

# Stray compiler/linker intermediates (gcc, Open Watcom), plus the raw
# dumps probes drop at the repo root when run without a -o path.
*.o
*.obj
*.err
*.out
*.map
*.lib
*.lst
*.mbr
*.sym
# gcov's notes, data and annotated listings.
*.gcov
*.gcda
*.gcno

# Binaries
/llama98
/llama98.exe
/llama98-w.exe
/llama98-dos.exe
/llama98.dll
/kunkun98-gui
/kunkun98-gui.exe
/kunkun98-w.exe
/kunkun98-serve
/kunkun98-serve.exe

# wrc/windres resource artifacts
gui/kunkun98.res

# Runtime config written beside the binary (kunkun98.ini, kunkun98-gui.ini,
# kunkun98-w.ini) - machine-local, and carries the classic_ui test switch
kunkun98*.ini

# Scratch / working directories
/tmp/
/.tmp/
/.cache/
/scratch/
/worktrees/
/.worktrees/
/out/
/dist/

# Model weights and test fixtures (never committed - too large)
/models/
*.gguf
*.safetensors
*.pth

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.orig
*.rej

# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Numeric probes (.prof/) - internal measurement tooling, excluded with
# the consequence understood: a fresh clone does not see them.
.prof/

# Python bytecode
__pycache__/
*.pyc

# Temp measurement outputs that accumulate in the working tree (probe
# runs and cwd slips scatter them; they must never enter a commit).
/logits_*.bin
/nll_*.bin
/w_logits_*.bin
/tap.bin
/*.dis
/llama98_f32count.exe
/.reasonix/
