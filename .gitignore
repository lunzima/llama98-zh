# Build products (regenerated by make). gen_exports.py is the one
# build/watcom file that IS source - a DLL build-time dependency - so it
# is explicitly re-included below.

/build/*
!/build/watcom/
/build/watcom/*
!/build/watcom/gen_exports.py

# Stray compiler/linker intermediates (gcc, Open Watcom)
*.o
*.obj
*.err
*.map
*.lib
*.lst
*.mbr
*.sym

# Binaries
/llama98
/llama98.exe
/llama98-w.exe
/llama98-dos.exe
/llama98.dll
/kunkun98-gui
/kunkun98-gui.exe
/kunkun98-w.exe
/kunkun98-serve
/kunkun98-serve.exe

# wrc/windres resource artifacts
gui/kunkun98.res

# Runtime config written beside the binary (kunkun98.ini, kunkun98-gui.ini,
# kunkun98-w.ini) - machine-local, and carries the classic_ui test switch
kunkun98*.ini

# Claude Code / AI assistant local config (machine-specific, not source)
.claude/
.claude.json
.claude.json.backup
.mcp.json
CLAUDE.md
CLAUDE.local.md
.aider*
.cursor/
.codeium/
.github/copilot-instructions.local.md

# Scratch / working directories
/tmp/
/.tmp/
/.cache/
/scratch/
/worktrees/
/.worktrees/
/out/
/dist/

# Model weights and test fixtures (never committed - too large)
/models/
*.gguf
*.safetensors
*.pth

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.orig
*.rej

# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Workflow scratch (design notes, plans). This project keeps its
# reasoning at the declaration it belongs to, not in a parallel tree.
docs/superpowers/
